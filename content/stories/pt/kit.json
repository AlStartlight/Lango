  "grammar": [
    {
      "id": "pt-gram-l1-presente",
      "level": 1,
      "pattern": "presente do indicativo",
      "meaning": {
        "id": "kata kerja bentuk sekarang",
        "en": "present indicative"
      },
      "example": "A Inês abre a banca às oito.",
      "note": "A1: rotinas e descrições. No português europeu a segunda pessoa tem forma própria (tu abres); no Brasil, «você» leva a terceira pessoa (você abre)."
    },
    {
      "id": "pt-gram-l1-contracoes",
      "level": 1,
      "pattern": "artigos e contrações (o, a, na, do, à)",
      "meaning": {
        "id": "artikel dan kontraksi",
        "en": "articles and contractions"
      },
      "example": "A banca fica na Feira do Relógio, ao lado do portão.",
      "note": "A1: em + a = na, de + o = do, a + a = à. As contrações são obrigatórias na escrita europeia; o português do Brasil usa as mesmas, mas a escolha de artigo antes de nomes próprios varia."
    },
    {
      "id": "pt-gram-l2-perfeito",
      "level": 2,
      "pattern": "pretérito perfeito simples",
      "meaning": {
        "id": "lampau selesai",
        "en": "simple past"
      },
      "example": "A Nenê abriu a banca e contou as moedas.",
      "note": "A2: ações concluídas. Em Portugal prefere-se o pretérito perfeito simples; no Brasil, sobretudo na fala, aparecem mais o perfeito composto (tenho aberto) e o imperfeito em alguns contextos."
    },
    {
      "id": "pt-gram-l2-estar-a",
      "level": 2,
      "pattern": "estar a + infinitivo",
      "meaning": {
        "id": "sedang melakukan",
        "en": "present progressive"
      },
      "example": "A Inês está a arrumar a louça.",
      "note": "A2: progressivo europeu. No Brasil usa-se sobretudo estar + gerúndio («está arrumando»); as duas formas são corretas nas respetivas normas."
    },
    {
      "id": "pt-gram-l3-imperfeito",
      "level": 3,
      "pattern": "pretérito imperfeito",
      "meaning": {
        "id": "lampau berulang dan deskripsi",
        "en": "imperfect past"
      },
      "example": "Quando era pequena, a Inês passava os domingos na feira.",
      "note": "B1: descrição, hábito e pano de fundo. Contraste com o perfeito: «abria a banca» (hábito) versus «abriu a banca» (ação única)."
    },
    {
      "id": "pt-gram-l3-subjuntivo",
