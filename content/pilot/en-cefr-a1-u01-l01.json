  "lesson": {
    "id": "en-cefr-a1-u01-l01",
    "position": 1,
    "slug": "articles-a-an-the",
    "title": "Articles: a, an, the",
    "objective": "Memilih artikel yang tepat berdasarkan bunyi awal dan makna",
    "skill": "grammar",
    "estimatedMinutes": 10,
    "materials": {
      "id": {
        "blocks": [
          {
            "type": "explanation",
            "text": "Artikel dalam bahasa Inggris bergantung pada apakah benda bisa dihitung dan apakah pendengar sudah tahu benda yang dimaksud. Gunakan 'a/an' untuk benda tunggal yang bisa dihitung dan belum spesifik; 'the' untuk benda spesifik atau unik; dan tanpa artikel untuk benda umum atau tidak bisa dihitung."
          },
          {
            "type": "rules",
            "items": [
              "Gunakan 'a' sebelum bunyi konsonan.",
              "Gunakan 'an' sebelum bunyi vokal.",
              "Gunakan 'the' untuk benda spesifik atau unik.",
              "Jangan gunakan artikel untuk benda umum yang tidak bisa dihitung."
            ]
          },
          {
            "type": "examples",
            "items": [
              {
                "correct": "I have an apple.",
                "annotation": "apple dimulai dengan bunyi vokal."
              },
              {
                "correct": "She is a teacher.",
                "annotation": "teacher dimulai dengan bunyi konsonan."
              },
              {
                "correct": "The sun is bright.",
                "annotation": "matahari adalah benda unik."
              },
              {
                "correct": "I like music.",
                "annotation": "music bersifat umum dan tidak bisa dihitung."
              }
            ]
          },
          {
            "type": "tips",
            "items": [
              "Dengarkan bunyi awal, bukan huruf awal.",
              "Kata seperti 'hour' dan 'honest' memakai 'an' karena 'h' tidak dilafalkan."
            ]
          }
        ]
      },
      "en": {
        "blocks": [
          {
            "type": "explanation",
            "text": "English articles depend on whether the noun is countable and whether the listener already knows which thing you mean. Use 'a/an' for a singular countable noun introduced for the first time, 'the' for something specific or unique, and no article for general or uncountable nouns."
          },
          {
            "type": "rules",
            "items": [
              "Use 'a' before a consonant sound.",
              "Use 'an' before a vowel sound.",
              "Use 'the' for specific or unique things.",
              "Use no article for general uncountable nouns."
            ]
          },
          {
            "type": "examples",
            "items": [
              {
                "correct": "I have an apple.",
                "annotation": "'apple' starts with a vowel sound."
              },
              {
                "correct": "She is a teacher.",
                "annotation": "'teacher' starts with a consonant sound."
              },
              {
                "correct": "The sun is bright.",
                "annotation": "The sun is unique."
              },
              {
                "correct": "I like music.",
                "annotation": "'music' is general and uncountable."
              }
            ]
          }
        ]
      }
    },
