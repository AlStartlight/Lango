# Environment Configuration for Lingo

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Web Vitals Endpoint (optional)
# Leave empty unless you run your own collector. A placeholder host makes every
# beacon fail; the client now ignores example/placeholder hosts as well.
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://lingo.com
NEXT_PUBLIC_SITE_NAME=Lingo

# Google Search Console Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification-code

# Social Media
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
NEXT_PUBLIC_TWITTER_HANDLE=@lingoapp

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lango?schema=lango"

# API Keys (server-side only)
# These should be kept secret and not exposed to the client
API_KEY=your-api-key

# Auth (generate with: openssl rand -hex 32)
APP_URL=http://localhost:3000
DB_SCHEMA=lango
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@lingo.com
