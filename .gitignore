# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated
app/lib/generated/

# clerk configuration (can include secrets)
/.clerk/
.npm-cache/
.cache/
/.prisma-engines/
.prompt-assets/

# local Chrome/CDP profiles used for screenshot tooling
# (Chrome creates a SingletonSocket here; Tailwind/Turbopack will try to
# read it and crash the CSS pipeline if it is not ignored)
.tmp-chrome/
.tmp-chrome-*/

# generated story libraries (deterministic; rebuild with `npm run content:stories:generate`)
content/stories/*/library/
